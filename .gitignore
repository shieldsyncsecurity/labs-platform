# Dependencies
node_modules/

# Next.js
.next/
out/

# Environment files — never commit secrets
.env.local
.env*.local
app/.env.local
.env
.env.production
# Cloudflare Workers local secrets — never commit (repo-wide; per-app rules also exist)
**/.dev.vars
# Keys / certs / logs — never commit (matches any directory, incl. engine/)
*.pem
*.key
*.log

# Internal-only docs (security audit findings, business strategy) — keep local
AUDIT_*.md
MONETIZATION_ROADMAP.md

# Dev-only local data stores — persisted IN the project (not OS temp, which
# Windows periodically wipes and once destroyed real candidate data). Never
# committed: candidate PII, uploaded KYC bytes, simulated outbound email.
engine/.dev-data/

# HR dev-data backup dir: never let a future dump of the real-PII dev store land
# here. Ignore everything, then re-allow ONLY the intentionally-tracked docs.
hr-dev-data-backup/*
!hr-dev-data-backup/GO-LIVE-snapshot.md
!hr-dev-data-backup/README.md
!hr-dev-data-backup/questionnaire-template-snapshot.ts

# Build artifacts
*.tsbuildinfo
engine/deploy/*.zip
engine/deploy/*-env.tmp.json
engine/bin/aws-nuke-linux
engine/bin/aws-nuke.exe
engine/bin/aws-nuke-v3.65.0-windows-amd64.zip

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
*.swp

# Local tooling / caches (per-machine, not project source)
.wrangler/
app/.wrangler/
.claude/
app/.claude/
.open-next/
app/.open-next/
infra/backup/backup-exporter.zip
