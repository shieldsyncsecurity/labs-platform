{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "shieldsync-hr",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // SECURITY: without this, Cloudflare serves static assets BEFORE the Worker
    // runs — the pre-signed signature + company seal would be publicly
    // fetchable at guessable paths. Routing /sealed/* through the Worker lets
    // proxy.ts require an authenticated HR session. /brand (logo) stays public.
    "run_worker_first": ["/sealed/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Cloudflare Browser Rendering — server-side PDF of issued documents
  // (Download PDF + auto-attached email). Included with Workers Paid.
  "browser": {
    "binding": "BROWSER"
  },
  "routes": [
    { "pattern": "employee.shieldsyncsecurity.com", "custom_domain": true }
  ],
  // NON-SECRET vars only. Secrets are set with `wrangler secret put`:
  //   HR_ENGINE_SECRET      -> x-engine-token to the HR Lambda (must match it)
  //   HR_SESSION_SECRET     -> HMAC key for the ss_hr session cookie (distinct
  //                            from the enterprise SESSION_SECRET on purpose)
  //   COGNITO_CLIENT_SECRET -> Cognito app-client secret
  //
  // Reuses the enterprise Cognito POOL but a DEDICATED app client (GO-LIVE
  // step 3 creates it: authorization-code grant, scopes openid email profile,
  // client secret, HR callback/sign-out URLs). The placeholder below MUST be
  // replaced with the NEW client's id — never the enterprise client's
  // (separate secret + callback list = no cross-app blast radius).
  "vars": {
    "HR_ENGINE_URL": "https://gwkfcf0ii3.execute-api.us-east-1.amazonaws.com",
    "APP_URL": "https://employee.shieldsyncsecurity.com",
    "COGNITO_REGION": "us-east-1",
    "COGNITO_POOL_ID": "us-east-1_54vIGJe4R",
    "COGNITO_CLIENT_ID": "7pei9flt4qnoercbb4lqb00bqf",
    "COGNITO_DOMAIN": "shieldsync-enterprise.auth.us-east-1.amazoncognito.com",
    "HR_ALLOWLIST": "admin@shieldsyncsecurity.com,hr@shieldsyncsecurity.com",
    // WHO IS THE OWNER. Administrators have everything, always, and their
    // status can NOT be changed from inside the portal — that is what makes
    // self-lockout impossible and stops anyone granting themselves admin.
    // Everyone else on HR_ALLOWLIST starts with NOTHING until granted at
    // /access. Changing this list requires a deploy, on purpose.
    "HR_ADMIN_EMAILS": "admin@shieldsyncsecurity.com",
    // Microsoft Graph — creates the Teams meeting and sends the candidate a
    // real Outlook invite. Client ID and tenant ID are NOT secrets (they're
    // visible in any OAuth request); MS_CLIENT_SECRET is, and is set with
    // `wrangler secret put` so it never lands in this file or in git.
    //
    // MS_ORGANISER_UPN is the mailbox meetings are created ON. It must be a
    // real licensed mailbox in the tenant — the app has app-only permission,
    // so it acts on that user's calendar rather than "its own".
    "MS_CLIENT_ID": "bc9861ae-295d-4009-b1d2-20671704405e",
    "MS_TENANT_ID": "6ea399a4-14cd-4b02-a780-6d77f51fd00f",
    "MS_ORGANISER_UPN": "himanshu@shieldsyncsecurity.com"
  }
}
